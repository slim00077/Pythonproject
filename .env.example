# Copiez ce fichier en « .env » puis adaptez les valeurs. Ne commitez JAMAIS le fichier .env.

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=True
# Générez une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=remplacez-moi-par-une-cle-secrete-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Tunis

# --- Base de données ---------------------------------------------------------------
# mysql-xampp (recommandé avec XAMPP) ; mysql (MySQL/MariaDB « natif », >= MariaDB 10.5
# ou MySQL 8) ; postgresql ; sqlite (repli local pour un premier essai, sans service à
# démarrer).
#
# XAMPP installe MariaDB 10.4, un cran sous le minimum que Django 5.2 exige pour le
# backend MySQL standard (MariaDB 10.5). « mysql-xampp » utilise un petit backend local
# (core/db_backends/mysql_xampp) qui ne change que ce seuil de version — le reste du
# comportement SQL est strictement celui du backend MySQL de Django. Si vous mettez à
# niveau MariaDB (10.11 LTS par exemple) ou utilisez MySQL, repassez sur DB_ENGINE=mysql.
DB_ENGINE=mysql-xampp
DB_NAME=ecoteams_db
DB_USER=ecoteams_user
DB_PASSWORD=CHANGE_THIS_TO_A_LOCAL_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Base de données (alternative PostgreSQL) -----------------------------------
# DB_ENGINE=postgresql
# POSTGRES_DB=ecoteams
# POSTGRES_USER=ecoteams
# POSTGRES_PASSWORD=remplacez-moi
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Données de démonstration (développement uniquement) --------------------------
# Mot de passe attribué aux comptes demo_* créés par « python manage.py seed_demo_data ».
DEMO_USER_PASSWORD=remplacez-moi-demo

# --- Réglages métier (facultatifs) ----------------------------------------------------
ECOTEAMS_MAX_UPLOAD_MB=5
ECOTEAMS_SUBMISSION_MAX_AGE_DAYS=30
ECOTEAMS_EVENT_REMINDER_HOURS=48

# --- Coach IA des objectifs (module 4) ----------------------------------------------
# Une seule clé suffit. Ne la commitez JAMAIS (ce fichier est un modèle : mettez la vraie clé dans « .env »).
# Gemini (clé gratuite sur https://aistudio.google.com/apikey) ou Anthropic (https://console.anthropic.com/).
# ECOTEAMS_AI_PROVIDER choisit le fournisseur des fonctions IA des objectifs ; la valeur de ce modèle est Gemini.
# Sans clé, le bouton « Obtenir un conseil » affiche un message explicite ; le reste de l'application fonctionne.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ECOTEAMS_AI_PROVIDER=gemini
ECOTEAMS_AI_MODEL=gemini-flash-lite-latest
ECOTEAMS_TEAM_AI_MODEL=gemini-flash-lite-latest
ECOTEAMS_AI_ENABLED=True
ECOTEAMS_AI_TIMEOUT_SECONDS=45
ECOTEAMS_AI_DAILY_LIMIT=10

# --- IA de la communauté (assistant de rédaction) -------------------------------
# template fonctionne sans service externe. Pour activer un endpoint compatible
# OpenAI : AI_PROVIDER=openai_compatible, une clé valide et une URL de base.
AI_PROVIDER=template
AI_API_KEY=remplacez-moi-par-une-cle-api-ia
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=10
AI_API_BASE_URL=https://api.openai.com/v1
